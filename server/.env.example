# Copie para server/.env e ajuste os valores. Nunca versione o .env real.
DATABASE_URL="file:./dev.db"
# Obrigatório. Gere com: openssl rand -hex 32 (mínimo de 32 bytes; em produção
# um segredo menor impede o servidor de subir).
JWT_SECRET=""
PORT=3001
CORS_ORIGIN="http://localhost:5173"
# Quantos proxies reversos ficam na frente da API (0 = acesso direto).
# Necessário para o limite de tentativas enxergar o IP real do cliente.
TRUST_PROXY=0
