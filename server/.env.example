# Copie para server/.env e ajuste os valores. Nunca versione o .env real.
#
# PostgreSQL (recomendado: Neon free — https://neon.tech).
# Use a connection string "direct" (sem -pooler) para prisma db push.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Obrigatório. Gere com: openssl rand -hex 32 (mínimo de 32 bytes; em produção
# um segredo menor impede o servidor de subir).
JWT_SECRET=""
PORT=3001
# Origens permitidas (vírgula se tiver mais de uma). Em produção: URL da Vercel.
CORS_ORIGIN="http://localhost:5173"
# Quantos proxies reversos ficam na frente da API (0 = acesso direto).
# No Render use 1.
TRUST_PROXY=0
